#!/bin/sh
# Usage: dmg-to-brew /path/to/application.dmg
# Creates/updates a local cask. Keep the DMG in place for future installs.
# Supports disk images containing exactly one .app (not .pkg installers).
set -eu
[ "$#" -eq 1 ] || { echo "Usage: $0 application.dmg" >&2; exit 1; }
[ -f "$1" ] || { echo "DMG not found: $1" >&2; exit 1; }
command -v brew >/dev/null 2>&1 || { echo "Install Homebrew first." >&2; exit 1; }

exec /usr/bin/ruby - "$1" <<'RUBY'
require "digest"
require "uri"
require "tmpdir"
require "fileutils"
require "open3"

def capture!(*args)
  output, status = Open3.capture2(*args)
  raise "Command failed: #{args.first}" unless status.success?
  output.strip
end

begin
  path = File.realpath(ARGV.fetch(0))
  checksum = Digest::SHA256.file(path).hexdigest
  app_path = nil
  version = nil
  Dir.mktmpdir("dmg-to-brew-") do |mount|
    mounted = false
    begin
      capture!("hdiutil", "attach", "-readonly", "-nobrowse", "-noautoopen",
               "-mountpoint", mount, path)
      mounted = true
      apps = Dir.glob("#{mount}/**/*.app").select do |app|
        File.directory?(app) && !File.symlink?(app) &&
          !app.delete_prefix("#{mount}/").split("/")[0...-1].any? { |part| part.end_with?(".app") }
      end
      raise "Expected exactly one .app; found #{apps.length}. Package installers and multi-app DMGs are unsupported." unless apps.length == 1
      app_path = apps.first.delete_prefix("#{mount}/")
      plist = File.join(apps.first, "Contents", "Info.plist")
      ["CFBundleShortVersionString", "CFBundleVersion"].each do |key|
        output, status = Open3.capture2e("/usr/libexec/PlistBuddy", "-c", "Print :#{key}", plist)
        if status.success? && !output.strip.empty?
          version = output.strip
          break
        end
      end
    ensure
      if mounted && !system("hdiutil", "detach", mount)
        # Do not let temporary-directory cleanup traverse a mounted image.
        warn "Could not unmount #{mount}; eject it manually."
        exit! 1
      end
    end
  end

  name = File.basename(app_path, ".app")
  slug = name.downcase.gsub(/[^a-z0-9]+/, "-").sub(/\A-/, "").sub(/-\z/, "")
  raise "App name cannot be converted to a Homebrew token: #{name}" if slug.empty?
  token = "#{slug}-local"
  tap = "local/dmg-apps"
  tap_dir = capture!("brew", "--repository", tap)
  capture!("brew", "tap-new", "--no-git", tap) unless File.directory?(tap_dir)
  FileUtils.mkdir_p(File.join(tap_dir, "Casks"))
  cask = File.join(tap_dir, "Casks", "#{token}.rb")
  url = "file://" + URI::DEFAULT_PARSER.escape(path, /[^a-zA-Z0-9\-._~\/]/)
  content = <<~CASK
    # Generated by dmg-to-brew; rerunning replaces this cask.
    cask #{token.dump} do
      version #{version ? version.dump : ':latest'}
      sha256 #{checksum.dump}
      url #{url.dump}
      name #{name.dump}
      desc "Application from a local disk image"
      app #{app_path.dump}
    end
  CASK
  # Write atomically so an interrupted update leaves the previous cask intact.
  temporary = "#{cask}.#{Process.pid}.tmp"
  begin
    File.write(temporary, content)
    File.rename(temporary, cask)
  ensure
    FileUtils.rm_f(temporary)
  end
  puts "\nRegistered #{name} (#{version || 'latest'}). Keep this DMG at #{path}"
  puts "Install with:\n  brew install --cask #{tap}/#{token}"
rescue StandardError => error
  warn "Error: #{error.message}"
  exit 1
end
RUBY
