#!/bin/sh
# Usage: dmg-to-brew [--no-install | --force] </path/to/application.dmg | https://...>
# Creates/updates a local cask, then installs it (or reinstalls it if already installed).
# --no-install  only register the cask.
# --force       overwrite an app in /Applications that Homebrew does not manage.
# Local file: the cask points to it, so keep the DMG in place for future installs.
# https URL:  the DMG is downloaded to a temporary directory and removed when done.
#             The cask points to the URL, so Homebrew downloads it again when needed.
# Supports disk images containing exactly one .app (not .pkg installers).
set -eu
usage="Usage: $0 [--no-install | --force] <application.dmg | https://url>"
install=1
force=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --no-install) install=0 ;;
    --force) force=1 ;;
    --) shift; break ;;
    -*) echo "Unknown option: $1" >&2; echo "$usage" >&2; exit 1 ;;
    *) break ;;
  esac
  shift
done
[ "$#" -eq 1 ] || { echo "$usage" >&2; exit 1; }
[ "$install" -eq 1 ] || [ "$force" -eq 0 ] || { echo "--force cannot be used with --no-install." >&2; exit 1; }
case "$1" in
  https://*) command -v curl >/dev/null 2>&1 || { echo "curl is required to download: $1" >&2; exit 1; } ;;
  *) [ -f "$1" ] || { echo "DMG not found: $1" >&2; exit 1; } ;;
esac
command -v brew >/dev/null 2>&1 || { echo "Install Homebrew first." >&2; exit 1; }

exec /usr/bin/ruby - "$1" "$install" "$force" <<'RUBY'
require "digest"
require "uri"
require "tmpdir"
require "fileutils"
require "open3"

def capture!(*args)
  output, status = Open3.capture2(*args)
  raise "Command failed: #{args.first}" unless status.success?
  output.strip
end

download_dir = nil
begin
  source = ARGV.fetch(0)
  remote_url = source.start_with?("https://") ? source : nil
  if remote_url
    download_dir = Dir.mktmpdir("dmg-to-brew-download-")
    path = File.join(download_dir, "download.dmg")
    puts "Downloading #{remote_url}"
    # --proto/--proto-redir keep every request, including redirects, on https.
    unless system("curl", "--fail", "--location", "--proto", "=https", "--proto-redir", "=https",
                  "--progress-bar", "--output", path, remote_url)
      raise "Download failed: #{remote_url}"
    end
  else
    path = File.realpath(source)
  end
  checksum = Digest::SHA256.file(path).hexdigest
  app_path = nil
  version = nil
  Dir.mktmpdir("dmg-to-brew-") do |mount|
    mounted = false
    begin
      capture!("hdiutil", "attach", "-readonly", "-nobrowse", "-noautoopen",
               "-mountpoint", mount, path)
      mounted = true
      apps = Dir.glob("#{mount}/**/*.app").select do |app|
        File.directory?(app) && !File.symlink?(app) &&
          !app.delete_prefix("#{mount}/").split("/")[0...-1].any? { |part| part.end_with?(".app") }
      end
      raise "Expected exactly one .app; found #{apps.length}. Package installers and multi-app DMGs are unsupported." unless apps.length == 1
      app_path = apps.first.delete_prefix("#{mount}/")
      plist = File.join(apps.first, "Contents", "Info.plist")
      ["CFBundleShortVersionString", "CFBundleVersion"].each do |key|
        output, status = Open3.capture2e("/usr/libexec/PlistBuddy", "-c", "Print :#{key}", plist)
        if status.success? && !output.strip.empty?
          version = output.strip
          break
        end
      end
    ensure
      if mounted && !system("hdiutil", "detach", mount)
        # Do not let temporary-directory cleanup traverse a mounted image.
        warn "Could not unmount #{mount}; eject it manually."
        exit! 1
      end
    end
  end

  name = File.basename(app_path, ".app")
  slug = name.downcase.gsub(/[^a-z0-9]+/, "-").sub(/\A-/, "").sub(/-\z/, "")
  raise "App name cannot be converted to a Homebrew token: #{name}" if slug.empty?
  token = "#{slug}-local"
  tap = "local/dmg-apps"
  tap_dir = capture!("brew", "--repository", tap)
  capture!("brew", "tap-new", "--no-git", tap) unless File.directory?(tap_dir)
  FileUtils.mkdir_p(File.join(tap_dir, "Casks"))
  cask = File.join(tap_dir, "Casks", "#{token}.rb")
  url = remote_url || "file://" + URI::DEFAULT_PARSER.escape(path, /[^a-zA-Z0-9\-._~\/]/)
  content = <<~CASK
    # Generated by dmg-to-brew; rerunning replaces this cask.
    cask #{token.dump} do
      version #{version ? version.dump : ':latest'}
      sha256 #{checksum.dump}
      url #{url.dump}
      name #{name.dump}
      desc #{(remote_url ? "Application from a downloaded disk image" : "Application from a local disk image").dump}
      app #{app_path.dump}
    end
  CASK
  # Write atomically so an interrupted update leaves the previous cask intact.
  temporary = "#{cask}.#{Process.pid}.tmp"
  begin
    File.write(temporary, content)
    File.rename(temporary, cask)
  ensure
    FileUtils.rm_f(temporary)
  end
  qualified = "#{tap}/#{token}"
  if remote_url
    puts "\nRegistered #{name} (#{version || 'latest'}) from #{remote_url}"
  else
    puts "\nRegistered #{name} (#{version || 'latest'}). Keep this DMG at #{path}"
  end
  if ARGV.fetch(1) == "1"
    # Homebrew only loads casks from trusted taps; installing this cask trusts it anyway.
    capture!("brew", "trust", "--cask", qualified)
    if remote_url
      # Put the verified download in the Homebrew cache so brew does not download it again.
      begin
        cache_path = capture!("brew", "--cache", "--cask", qualified)
        FileUtils.mkdir_p(File.dirname(cache_path))
        FileUtils.mv(path, cache_path)
      rescue StandardError
        warn "Could not prime the Homebrew cache; brew will download the DMG again."
      end
    end
    # Reinstall when already installed so a new DMG with the same version still replaces the app.
    installed = capture!("brew", "list", "--cask", "-1").split("\n").include?(token)
    action = installed ? "reinstall" : "install"
    command = ["brew", action, "--cask"]
    command << "--force" if ARGV.fetch(2) == "1"
    command << qualified
    puts "Running: #{command.join(' ')}"
    unless system(*command)
      hint = ARGV.fetch(2) == "1" ? "" : " If the app already exists in /Applications, add --force to overwrite it."
      raise "brew #{action} failed. Fix the issue above, then run: #{command.join(' ')}.#{hint}"
    end
    puts "Installed #{name} (#{version || 'latest'})."
  else
    puts "Install with:\n  brew install --cask #{qualified}"
  end
rescue StandardError => error
  warn "Error: #{error.message}"
  exit 1
ensure
  FileUtils.rm_rf(download_dir) if download_dir
end
RUBY
