#!/bin/bash

PLUGIN_DIR="$CONFIG_DIR/plugins"

# Keep the islands within this display's 32px macOS menu-bar safe area.
# SketchyBar does not reserve extra space for normal application windows.
sketchybar --bar position=top height=32 margin=12 y_offset=0 \
  padding_left=8 padding_right=8 color=0x00000000 \
  blur_radius=0 shadow=off border_width=0 font_smoothing=on

sketchybar --default \
  padding_left=4 padding_right=4 \
  icon.font="Hack Nerd Font:Regular:15.0" \
  label.font="SF Pro:Medium:13.0" \
  icon.color=0xffe0e2eb label.color=0xffe0e2eb \
  icon.padding_left=6 icon.padding_right=4 \
  label.padding_left=4 label.padding_right=6 \
  background.height=26 background.corner_radius=10

# Space components automatically hide spaces that do not exist on a display.
for sid in {1..10}; do
  click_script='open -a "Mission Control"'
  if command -v yabai >/dev/null 2>&1; then
    click_script="yabai -m space --focus $sid"
  fi
  sketchybar --add space space."$sid" left \
    --set space."$sid" space="$sid" \
    icon="$sid" icon.font="SF Pro:Medium:13.0" \
    icon.color=0xffc8cbd6 icon.highlight_color=0xff20202a \
    icon.padding_left=9 icon.padding_right=9 \
    label.drawing=off background.color=0xffc4b5fd \
    background.height=22 background.corner_radius=7 \
    script="$PLUGIN_DIR/space.sh" click_script="$click_script"
done

sketchybar --add bracket workspaces '/space\..*/' \
  --set workspaces background.color=0xff20222b background.drawing=on

sketchybar --add item app_gap left \
  --set app_gap width=12 icon.drawing=off label.drawing=off \
  --add item front_app left \
  --set front_app icon.drawing=off label.padding_left=12 label.padding_right=12 \
    background.color=0xff20222b background.drawing=on \
    script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

# Right-side items are added from right to left.
sketchybar --add item clock_no right \
  --set clock_no update_freq=10 icon=NO icon.font="SF Pro:Medium:11.0" \
    icon.color=0xffaeb4c2 label.padding_right=12 script="$PLUGIN_DIR/clock_no.sh" \
  --add item clock_id right \
  --set clock_id update_freq=10 icon=ID icon.font="SF Pro:Medium:11.0" \
    icon.color=0xffaeb4c2 icon.padding_left=12 script="$PLUGIN_DIR/clock_id.sh" \
  --add bracket clocks clock_id clock_no \
  --set clocks background.color=0xff20222b background.drawing=on \
  --add item status_gap right \
  --set status_gap width=12 icon.drawing=off label.drawing=off \
  --add item battery right \
  --set battery update_freq=120 label.padding_right=12 script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery system_woke power_source_change \
  --add item volume right \
  --set volume icon.padding_left=12 script="$PLUGIN_DIR/volume.sh" \
  --subscribe volume volume_change \
  --add bracket status volume battery \
  --set status background.color=0xff20222b background.drawing=on

# Keep media beside the app island, away from the display notch.
sketchybar --add item media_gap left \
  --set media_gap width=12 drawing=off icon.drawing=off label.drawing=off \
  --add item media left \
  --set media drawing=off updates=on update_freq=5 \
    icon.color=0xffc4b5fd icon.padding_left=12 \
    label.max_chars=28 label.padding_right=12 \
    background.color=0xff20222b background.drawing=on \
    script="$PLUGIN_DIR/media.sh" click_script="$PLUGIN_DIR/media.sh toggle" \
  --subscribe media system_woke

sketchybar --update
